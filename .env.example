# Copy to .env for local runs (git-ignored). In CI these are repository secrets.
# Variables already set in the environment take precedence over this file.

# Email digest via Gmail SMTP (needs 2-Step Verification + an app password)
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_TO=you@gmail.com
# MAIL_FROM=you@gmail.com          # default: SMTP_USER
# SMTP_ADDR=smtp.gmail.com:587     # default

# WhatsApp alerts via CallMeBot (see README §8 for the one-time setup)
CALLMEBOT_PHONE=+84xxxxxxxxx
CALLMEBOT_APIKEY=123456
