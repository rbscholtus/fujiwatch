03E\u0026nbsp;\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u003Cimg src=\u0022//file.hstatic.net/200000396087/file/5_596b2570a41d487cb25f07ad1b9230fa_2048x2048.jpg\u0022\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center;\u0022\u003E\u003Cstrong\u003ETristan Shu (Ph\u00E1p)\u003Cbr\u003EFUJIFILM X-T4 10mm | F7.1 | 1/3800 | ISO400\u003Cbr\u003EXF10-24mmF4 R OIS WR\u003C/strong\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center;\u0022\u003E\u0026nbsp;\u003C/p\u003E\u003Ch2 style=\u0022text-align: center;\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022font-size:36px\u0022\u003E\u1ED0ng k\u00EDnh g\u00F3c r\u1ED9ng t\u1ED1t nh\u1EA5t\u003C/span\u003E\u003C/strong\u003E\u003C/h2\u003E\u003Chr\u003E\u003Cp\u003EV\u1EDBi d\u1EA3i ti\u00EAu c\u1EF1 t\u01B0\u01A1ng \u0111\u01B0\u01A1ng tr\u00EAn 35mm l\u00E0 15-36mm, XF10-24mmF4 R OIS WR l\u00E0 m\u1ED9t \u1ED1ng k\u00EDnh zoom g\u00F3c r\u1ED9ng nh\u1ECF g\u1ECDn cho ph\u00E9p b\u1EA1n ti\u1EBFp c\u1EADn t\u1EA5t c\u1EA3 c\u00E1c ti\u00EAu c\u1EF1 g\u00F3c r\u1ED9ng 35mm c\u1ED5 \u0111i\u1EC3n trong m\u1ED9t \u1ED1ng k\u00EDnh. B\u1EA5t k\u1EC3 b\u1EA1n ch\u1ECDn ti\u00EAu c\u1EF1 n\u00E0o, \u1ED1ng k\u00EDnh n\u00E0y ch\u1EAFc ch\u1EAFn s\u1EBD gi\u00FAp b\u1EA1n khai th\u00E1c nh\u1EEFng \u0111i\u1EC1u khi\u1EBFn cho vi\u1EC7c ch\u1EE5p \u1EA3nh g\u00F3c r\u1ED9ng tr\u1EDF n\u00EAn th\u1EF1c s\u1EF1 vui v\u1EBB v\u00E0 th\u00FA v\u1ECB.\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Ch2 style=\u0022text-align: center;\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022font-size:36px\u0022\u003ES\u00E1ng t\u1EA1o t\u1EEB tr\u00E1i tim\u003C/span\u003E\u003C/strong\u003E\u003C/h2\u003E\u003Chr\u003E\u003Cp\u003E\u0110\u01B0\u1EE3c thi\u1EBFt k\u1EBF \u0111\u1EC3 c\u00F3 kh\u1EA3 n\u0103ng l\u1EA5y n\u00E9t t\u1EF1 \u0111\u1ED9ng ch\u00EDnh x\u00E1c, nh\u1EA1y, vi\u1EC7c s\u00E1ng t\u1EA1o h\u00ECnh \u1EA3nh v\u1EDBi XF10-24mmF4 R OIS WR tr\u1EDF th\u00E0nh b\u1EA3n n\u0103ng, g\u1EA7n nh\u01B0 im l\u1EB7ng v\u00E0 ch\u00EDnh x\u00E1c. C\u00E1c th\u1EA5u k\u00EDnh l\u1EA5y n\u00E9t nh\u1EB9 di chuy\u1EC1n v\u00E0o \u0111\u00FAng v\u1ECB tr\u00ED v\u1EDBi s\u1EF1 tr\u1EE3 gi\u00FAp c\u1EE7a \u0111\u1ED9ng c\u01A1 c\u00F3 \u0111\u1ED9 ch\u00EDnh x\u00E1c cao, d\u1EC5 d\u00E0ng gi\u1EEF cho ch\u1EE7 th\u1EC3 lu\u00F4n s\u1EAFc n\u00E9t v\u00E0 gi\u1EEF ti\u00EAu \u0111i\u1EC3m m\u1ED9t c\u00E1ch \u0111\u00E1ng tin c\u1EADy, ngay c\u1EA3 khi ch\u00FAng \u0111ang di chuy\u1EC3n trong khung h\u00ECnh. Ch\u1EC9 c\u1EA7n s\u00E1ng t\u1EA1o h\u00ECnh \u1EA3nh khi b\u1EA1n nh\u00ECn th\u1EA5y ch\u00FAng v\u00E0 c\u00F3 th\u1EC3 t\u1EF1 do vi\u1EBFt n\u00EAn c\u00E2u chuy\u1EC7n trong b\u1EA5t k\u1EF3 th\u1EDDi \u0111i\u1EC3m n\u00E0o.\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u003Cimg src=\u0022//file.hstatic.net/200000396087/file/6_decf91ea3f18417bb1b65712aa1b28d3_2048x2048.jpg\u0022\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u003Cstrong\u003ETristan Shu (Ph\u00E1p)\u003Cbr\u003EFUJIFILM X-T4 | 10mm | F7.1 | 1/4000| ISO640\u003Cbr\u003EXF10-24mmF4 R OIS WR\u003C/strong\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u0026nbsp;\u003C/p\u003E\u003Ch2 style=\u0022text-align: center;\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022font-size:36px\u0022\u003ENh\u1EEFng H\u00ECnh \u1EA2nh L\u00E0m B\u1EA1n Cho\u00E1ng Ng\u1EE3p\u003C/span\u003E\u003C/strong\u003E\u003C/h2\u003E\u003Chr\u003E\u003Cp\u003EHi\u1EC7n t\u01B0\u1EE3ng gi\u00E3n n\u1EDF g\u00F3c nh\u00ECn (lens breathing) l\u00E0 m\u1ED9t hi\u1EC7n t\u01B0\u1EE3ng g\u00E2y m\u1EA5t t\u1EADp trung c\u00F3 th\u1EC3 l\u00E0m thay \u0111\u1ED5i b\u1ED1 c\u1EE5c c\u1EE7a h\u00ECnh \u1EA3nh v\u00E0 video c\u1EE7a b\u1EA1n khi \u1ED1ng k\u00EDnh \u0111ang l\u1EA5y n\u00E9t. \u0110\u1EC3 gi\u1EA3m thi\u1EC3u hi\u1EC7n t\u01B0\u1EE3ng n\u00E0y, th\u1EA5u k\u00EDnh l\u1EA5y n\u00E9t b\u00EAn trong XF10-24mmF4 R OIS WR \u0111\u00E3 \u0111\u01B0\u1EE3c \u0111\u1EB7t g\u1EA7n c\u1EA3m bi\u1EBFn h\u00ECnh \u1EA3nh, c\u00E1ch xa v\u00F2ng kh\u1EA9u \u0111\u1ED9 v\u00E0 \u0111\u01B0\u1EE3c gh\u00E9p n\u1ED1i v\u1EDBi th\u1EA5u k\u00EDnh phi c\u1EA7u ED. \u0110i\u1EC1u n\u00E0y d\u1EABn \u0111\u1EBFn ch\u1EA5t l\u01B0\u1EE3ng h\u00ECnh \u1EA3nh \u0111\u1ED3ng nh\u1EA5t t\u1EEB \u200B\u200Bkho\u1EA3ng c\u00E1ch l\u1EA5y n\u00E9t t\u1ED1i thi\u1EC3u \u0111\u1EBFn v\u00F4 c\u1EF1c, gi\u00FAp lo\u1EA1i b\u1ECF s\u1EF1 ph\u00E2n t\u00E2m ra kh\u1ECFi qu\u00E1 tr\u00ECnh s\u00E1ng t\u1EA1o c\u1EE7a b\u1EA1n.\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u003Cimg src=\u0022//file.hstatic.net/200000396087/file/7_93520a12ac1447ea9e9fadd45b851174_2048x2048.jpg\u0022\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u0026nbsp;\u003C/p\u003E\u003Ch2 style=\u0022text-align: center;\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022font-size:36px\u0022\u003ET\u1EF1 Do S\u00E1ng T\u1EA1o H\u01A1n\u003C/span\u003E\u003C/strong\u003E\u003C/h2\u003E\u003Chr\u003E\u003Cp\u003EKh\u00E1m ph\u00E1 nh\u1EEFng \u0111\u1ECBa \u0111i\u1EC3m m\u1EDBi v\u00E0 tho\u1EA3i m\u00E1i qu\u00EAn \u0111i tripod c\u1EE7a b\u1EA1n, s\u00E1ng t\u1EA1o t\u1EEB nh\u1EEFng g\u00F3c m\u1EDBi v\u00E0 t\u1EA1o khung h\u00ECnh cho nh\u1EEFng b\u1ED1 c\u1EE5c th\u00FA v\u1ECB, ngay c\u1EA3 sau khi m\u1EB7t tr\u1EDDi l\u1EB7n. T\u00EDnh \u1ED5n \u0111\u1ECBnh b\u1ED5 sung \u0111\u1EBFn v\u1EDBi XF10-24mmF4 R OIS WR d\u01B0\u1EDBi d\u1EA1ng c\u1EA3m bi\u1EBFn con quay h\u1ED3i chuy\u1EC3n m\u1EDBi, tinh vi gi\u00FAp c\u1EA3i thi\u1EC7n t\u00EDnh n\u0103ng \u1ED4n \u0111\u1ECBnh h\u00ECnh \u1EA3nh quang h\u1ECDc (OIS) so v\u1EDBi phi\u00EAn b\u1EA3n tr\u01B0\u1EDBc c\u1EE7a n\u00F3 c\u1EA3 01 stop. \u0110i\u1EC1u n\u00E0y mang l\u1EA1i hi\u1EC7u su\u1EA5t gi\u1EA3m rung l\u00EAn \u0111\u1EBFn 3.5 stops, c\u00F3 th\u1EC3 m\u1EDF r\u1ED9ng th\u00EAm \u0111\u1EBFn 6.5 stops khi \u0111\u01B0\u1EE3c gh\u00E9p n\u1ED1i v\u1EDBi m\u00E1y \u1EA3nh X Series hi\u1EC7n t\u1EA1i \u0111\u01B0\u1EE3c trang b\u1ECB t\u00EDnh n\u0103ng \u1ED4n \u0111\u1ECBnh h\u00ECnh \u1EA3nh trong th\u00E2n m\u00E1y (IBIS), nh\u01B0 FUJIFILM X-T4. B\u1EA5t k\u1EC3 \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng v\u1EDBi m\u00E1y \u1EA3nh n\u00E0o, kh\u1EA3 n\u0103ng c\u1EA7m tay \u1ED5n \u0111\u1ECBnh l\u00E0 m\u1ED9t \u0111i\u1EC1u ch\u1EAFc ch\u1EAFn.\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u003Cimg src=\u0022//file.hstatic.net/200000396087/file/8_554781bf534e4b8a93bcf34c850f348c_2048x2048.jpg\u0022\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u0026nbsp;\u003C/p\u003E\u003Ch2 style=\u0022text-align: center;\u0022\u003E\u003Cspan style=\u0022font-size:36px\u0022\u003E\u003Cstrong\u003ELi\u00EAn T\u1EE5c Ti\u1EBFn H\u00F3a \u0110\u1EC3 M\u1EDF R\u1ED9ng Kh\u1EA3 N\u0103ng\u003C/strong\u003E\u003C/span\u003E\u003C/h2\u003E\u003Chr\u003E\u003Cp\u003ENgo\u00E0i kh\u1EA3 n\u0103ng ch\u1ED1ng ch\u1ECBu th\u1EDDi ti\u1EBFt, ch\u1EE7 y\u1EBFu b\u1EA3o v\u1EC7 XF10-24mmF4 R OIS WR kh\u1ECFi b\u1EE5i v\u00E0 \u0111\u1ED9 \u1EA9m, m\u1ED9t s\u1ED1 c\u1EA3i ti\u1EBFn kh\u00E1c \u0111\u00E3 \u0111\u01B0\u1EE3c mang \u0111\u1EBFn cho phi\u00EAn b\u1EA3n m\u1EDBi nh\u1EA5t c\u1EE7a \u1ED1ng k\u00EDnh n\u00E0y. V\u00ED d\u1EE5: kh\u00F3a v\u1ECB tr\u00ED A \u0111\u00E3 \u0111\u01B0\u1EE3c th\u00EAm v\u00E0o v\u00F2ng kh\u1EA9u \u0111\u1ED9 \u0111\u1EC3 ng\u0103n nh\u1EEFng thay \u0111\u1ED5i b\u1EA5t ng\u1EDD \u0111\u1ED1i v\u1EDBi c\u00E0i \u0111\u1EB7t kh\u1EA9u \u0111\u1ED9 c\u1EE7a \u1ED1ng k\u00EDnh. M\u1ED9t thang kh\u1EA9u \u0111\u1ED9 m\u1EDBi c\u0169ng \u0111\u00E3 \u0111\u01B0\u1EE3c th\u00EAm v\u00E0o v\u00F2ng kh\u1EA9u \u0111\u1ED9 cho ph\u00E9p ki\u1EC3m tra c\u00E0i \u0111\u1EB7t kh\u1EA9u \u0111\u1ED9 m\u00E0 kh\u00F4ng c\u1EA7n ki\u1EC3m tra tr\u00EAn m\u00E0n h\u00ECnh. Cu\u1ED1i c\u00F9ng, chi\u1EC1u r\u1ED9ng c\u1EE7a c\u1EA3 v\u00F2ng kh\u1EA9u \u0111\u1ED9 v\u00E0 v\u00F2ng l\u1EA5y n\u00E9t \u0111\u00E3 gi\u1EA3m 1mm, gi\u00FAp gi\u1EA3m 25g (0,9 oz) t\u1ED5ng tr\u1ECDng l\u01B0\u1EE3ng c\u1EE7a \u1ED1ng k\u00EDnh so v\u1EDBi phi\u00EAn b\u1EA3n tr\u01B0\u1EDBc. Nh\u1EEFng c\u1EA3i ti\u1EBFn n\u00E0y d\u1EABn \u0111\u1EBFn m\u1ED9t \u1ED1ng k\u00EDnh thi\u1EBFt th\u1EF1c, di \u0111\u1ED9ng v\u00E0 b\u1EC1n b\u1EC9, c\u00F3 ngh\u0129a l\u00E0 \u1ED1ng k\u00EDnh \u0111\u01A1n gi\u1EA3n l\u00E0 \u0111\u00E1ng tin c\u1EADy trong nh\u1EEFng kho\u1EA3nh kh\u1EAFc quan tr\u1ECDng nh\u1EA5t.\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u003Cimg src=\u0022//file.hstatic.net/200000396087/file/9_2638360c09c745e7aad459694f93e54d_2048x2048.jpg\u0022\u003E\u003C/p\u003E\u003Cp style=\u0022text-align: center\u0022\u003E\u0026nbsp;\u003C/p\u003E\u003Ch2 style=\u0022text-align: center;\u0022\u003E\u003Cstrong\u003E\u003Cspan style=\u0022font-size:36px\u0022\u003EChia s\u1EBB\u0026nbsp;c\u1EE7a Nhi\u1EBFp \u1EA3nh gia\u003C/span\u003E\u003C/strong\u003E\u003C/h2\u003E\u003Chr\u003E\u003Cp\u003E\u003Cstrong\u003EC\u00E2u tr\u1EA3 l\u1EDDi cho phong c\u00E1ch ch\u1EE5p c\u1EE7a t\u00F4i\u003C/strong\u003E\u003C/p\u003E\u003Cp\u003EKhi t\u00F4i c\u1EA7n th\u1EC3 hi\u1EC7n s\u1EF1 h\u00F9ng v\u0129 c\u1EE7a \u0111\u1ED1i t\u01B0\u1EE3ng ho\u1EB7c khi t\u00F4i ph\u1EA3i ch\u1EE5p trong m\u1ED9t kh\u00F4ng gian h\u1EA1n ch\u1EBF nh\u01B0ng mu\u1ED1n th\u1EC3 hi\u1EC7n n\u00F3 \u1EDF m\u1ED9t g\u00F3c nh\u00ECn r\u1ED9ng, \u1ED1ng k\u00EDnh n\u00E0y l\u00E0 c\u00E2u tr\u1EA3 l\u1EDDi.\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003EKankavee Kanjanadecha\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003EThailand\u003C/p\u003E\u003Chr\u003E\u003Cp\u003E\u003Cstrong\u003EXF10-24mm cho ph\u00E9p t\u00F4i nh\u00ECn th\u1EBF gi\u1EDBi r\u1ED9ng l\u1EDBn h\u01A1n\u003C/strong\u003E\u003C/p\u003E\u003Cp\u003ET\u00F4i th\u00EDch b\u1EA3n th\u00E2n \u1EDF trung t\u00E2m c\u1EE7a h\u00E0nh \u0111\u1ED9ng. T\u00F4i th\u00EDch nh\u00ECn th\u1EBF gi\u1EDBi r\u1ED9ng l\u1EDBn. XF10-24mmF4 l\u00E0 m\u1ED9t \u1ED1ng k\u00EDnh lu\u00F4n c\u00F3 trong t\u00FAi c\u1EE7a t\u00F4i. N\u00F3 lu\u00F4n \u1EDF \u0111\u00F3.\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003ETristan Shu\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003EPh\u00E1p\u003C/p\u003E\u003Chr\u003E\u003Cp\u003E\u003Cstrong\u003ES\u1EF1 c\u1EA3i ti\u1EBFn \u0111\u01B0\u1EE3c g\u00F3i g\u1ECDn trong m\u1ED9t \u1ED1ng k\u00EDnh nh\u1ECF h\u01A1n v\u00E0 nh\u1EB9 h\u01A1n\u003C/strong\u003E\u003C/p\u003E\u003Cp\u003EXF10-24mmF4 R OIS WR m\u1EDBi k\u1EBF th\u1EEBa nh\u1EEFng ph\u1EA9m ch\u1EA5t c\u1EE7a XF10-24mmF4 R OIS tr\u01B0\u1EDBc \u0111\u00F3 v\u00E0 t\u1EF1 h\u00E0o c\u00F3 th\u00EAm m\u1ED9t s\u1ED1 c\u1EA3i ti\u1EBFn.\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003EJakub Cepjpek\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003EC\u1ED9ng H\u00F2a Czech\u003C/p\u003E\u003Cp style=\u0022text-align: right;\u0022\u003E\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Cp\u003E####\u003C/p\u003E\u003Cdiv style=\u0022text-align: center;\u0022\u003E\u003Ch2\u003E\u003Cspan style=\u0022font-size:18pt\u0022\u003E\u003Cspan style=\u0022vertical-align:baseline\u0022\u003E\u003Cspan style=\u0022font-family:\u0026quot;Times New Roman\u0026quot;,serif\u0022\u003E\u003Cstrong style=\u0022font-weight:bold\u0022\u003E\u003Cspan style=\u0022font-size:36.0pt\u0022\u003E\u003Cspan style=\u0022font-family:Oswald\u0022\u003E\u003Cspan style=\u0022color:#1b1b1b\u0022\u003EC\u003C/span\u003E\u003C/span\u003E\u003C/span\u003E\u003Cspan style=\u0022font-size:36.0pt\u0022\u003E\u003Cspan style=\u0022font-family:\u0026quot;Cambria\u0026quot;,serif\u0022\u003E\u003Cspan style=\u0022color:#1b1b1b\u0022\u003E\u1